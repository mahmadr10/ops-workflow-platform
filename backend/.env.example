# Copy this file to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ops_platform?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# One-time demo seed endpoint (POST /api/system/seed-demo-data with header x-seed-secret).
# Only used on hosts with no shell access, e.g. Render's free tier. Leave unset to disable it.
SEED_SECRET=""

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info

# AI provider (OpenAI-compatible). Works with Groq, OpenAI, DeepSeek, Ollama, LM Studio, etc.
AI_PROVIDER=groq
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="openai/gpt-oss-120b"

# Notifications (all optional; unset channels simply fail gracefully and are logged)
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
GENERIC_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ops-platform@example.com"
