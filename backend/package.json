    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "json2csv": "^6.0.0-alpha.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "openai": "^4.67.3",
    "pdfkit": "^0.15.0",
    "prom-client": "^15.1.3",
    "pino": "^9.4.0",
