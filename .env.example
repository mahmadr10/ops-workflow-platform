# Root env file used by docker-compose. Copy to .env and fill in real values.

JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# AI provider (OpenAI-compatible: Groq, OpenAI, DeepSeek, Ollama, LM Studio...)
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Notifications (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
